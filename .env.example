# Environment
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Database (MySQL via XAMPP)
# Default XAMPP MySQL configuration: host=localhost, port=3306, user=root, password is empty
DATABASE_URL=mysql+pymysql://root:@localhost:3306/examind

# Security / JWT
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings (Optional / Configurable)
AI_PROVIDER=
AI_API_KEY=
